# Used to name the log file. Every run appends its output to storage/logs/<APP_NAME>.log.
APP_NAME=image_converter

# Directory containing the source images to convert.
# Windows:      C:\Users\YourName\Pictures\source
# WSL2 (Windows drive mounted under /mnt): /mnt/c/Users/YourName/Pictures/source
# Linux:        /home/yourname/Pictures/source
# macOS:        /Users/yourname/Pictures/source
INPUT_DIR=/mnt/c/Users/YourName/Pictures/source

# Directory where converted images will be written. Created automatically if it doesn't exist.
# Windows:      C:\Users\YourName\Pictures\converted
# WSL2 (Windows drive mounted under /mnt): /mnt/c/Users/YourName/Pictures/converted
# Linux:        /home/yourname/Pictures/converted
# macOS:        /Users/yourname/Pictures/converted
OUTPUT_DIR=/mnt/c/Users/YourName/Pictures/converted

# Comma-separated list of source file extensions to select from INPUT_DIR (no dots, case-insensitive).
# Only files matching one of these extensions are picked up for conversion - everything else is ignored.
# Use * to accept any image format Pillow recognizes.
# Common values: png, jpg, jpeg, webp, bmp, tiff, gif, ico, pnm, ppm, pgm, pbm
# Example (single):   SOURCE_FORMATS=png
# Example (multiple): SOURCE_FORMATS=png,bmp,tiff,gif
SOURCE_FORMATS=png

# Single format to convert the selected files to. Any one format Pillow can write.
# Common values: webp, jpg, jpeg, png, bmp, tiff, gif, ico
TARGET_FORMAT=jpeg

# Output image quality, 1-100. Higher is better quality but larger file size.
QUALITY=100

# If true, overwrite existing output files. If false, a new file is created with a numbered
# suffix instead (e.g. photo_1.webp) so nothing already converted is ever clobbered.
OVERWRITE=false

# If true, also scan subdirectories of INPUT_DIR. Output preserves the same subfolder structure.
RECURSIVE=true

# If true, only show what would be converted without writing any files.
DRY_RUN=false

